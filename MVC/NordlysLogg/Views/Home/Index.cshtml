@model DashboardViewModel
@{
    ViewData["Title"] = "Forside";
}

<section class="hero text-center py-5 mb-4">
    <h1 class="display-4 fw-bold brand-glow">Se opp.</h1>
    <p class="lead text-secondary mb-4">@Model.SeasonMessage</p>
    <a class="btn btn-aurora btn-lg" asp-controller="Sightings" asp-action="Create">Logg en observasjon</a>
</section>

<div class="row g-3 mb-5 text-center">
    <div class="col-md-4">
        <div class="stat-tile"><div class="stat-value">@Model.TotalSightings</div><div class="stat-label">observasjoner</div></div>
    </div>
    <div class="col-md-4">
        <div class="stat-tile"><div class="stat-value">@Model.SiteCount</div><div class="stat-label">steder</div></div>
    </div>
    <div class="col-md-4">
        <div class="stat-tile"><div class="stat-value">@Model.ObserverCount</div><div class="stat-label">observatører</div></div>
    </div>
</div>

@if (Model.MostSpectacular is { } best)
{
    <h2 class="h4 mb-3">🏆 Mest spektakulære observasjon</h2>
    <div class="card champion-card mb-5">
        <div class="card-body d-flex flex-wrap gap-4 align-items-center">
            <div class="champion-score">@best.WowScore</div>
            <div class="flex-grow-1">
                <h3 class="h5 mb-1">@best.Site?.Name</h3>
                <div class="text-secondary mb-2">
                    @best.ObservedAt.ToString("dd.MM.yyyy HH:mm") · Kp @best.KpIndex ·
                    @best.Intensity.GetDisplayName() · @best.DominantColor.GetDisplayName()
                </div>
                <div>Observert av <strong>@best.Observer?.Name</strong></div>
            </div>
            <a class="btn btn-outline-light" asp-controller="Sightings" asp-action="Details" asp-route-id="@best.Id">Se detaljer</a>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-baseline mb-3">
    <h2 class="h4 mb-0">Siste observasjoner</h2>
    <a asp-controller="Sightings" asp-action="Index">Se alle →</a>
</div>
<div class="row g-3">
    @foreach (var sighting in Model.Recent)
    {
        <div class="col-sm-6 col-lg-3">
            <partial name="_SightingCard" model="sighting" />
        </div>
    }
</div>
