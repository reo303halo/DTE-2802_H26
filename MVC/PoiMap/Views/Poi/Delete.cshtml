@model PoiViewModel
@{
    ViewData["Title"] = "Delete POI";
}

<h1 class="h3 mb-3">Delete POI</h1>

<p>Are you sure you want to delete this POI? This cannot be undone.</p>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Category</dd>
    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>
    <dt class="col-sm-2">Position</dt>
    <dd class="col-sm-10">@Model.Latitude.ToString("F4"), @Model.Longitude.ToString("F4")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
