@model PoiFormViewModel
@{
    ViewData["Title"] = "Add POI";
}

<h1 class="h3 mb-3">Add POI</h1>

<form asp-action="Create" method="post">
    <partial name="_PoiForm" model="Model" />

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/poi-picker.js" asp-append-version="true"></script>
}
